  "preprocessing_steps": [
    "Buffer one rep using shoulder-abduction state machine.",
    "Resample buffered raw keypoints to T=68 via linear interpolation.",
    "Compute 6 joint angles per frame -> (T, 6).",
    "Append centered angular velocity -> (T, 12) = [angles | velocities].",
    "Standardize: x = (x - x_mean) / x_std.",
    "Clip to [-5.0, 5.0].",
