# CONFIG
# ══════════════════════════════════════════════════════════════════
SMOOTH_ALPHA       = 0.5     # feature pipeline EMA (matches training)
MIN_FRAMES         = 8

# ── Smooth State Machine (all relative, no fixed angles) ────────
ANGLE_EMA          = 0.40    # smoothing on raw angle
VEL_EMA            = 0.35    # smoothing on velocity
REST_EMA           = 0.02    # how fast rest baseline adapts (slow)
PRE_ROLL           = 20      # pre-roll frames to capture motion start
MAX_REC_FRAMES     = 180     # timeout safety
COOLDOWN_FRAMES    = 15      # pause between reps

# Velocity softness (degrees/frame — very loose, not body-dependent)
VEL_RISING         = 0.4     # arm is moving up
VEL_PEAKED         = -0.15   # velocity turned negative → peaked
VEL_STILL          = 0.35    # arm stopped moving

# Relative motion (percentage/degrees from YOUR rest, not fixed)
MIN_RISE_FROM_REST = 8.0     # minimum degrees risen to start recording
MIN_PEAK_RISE      = 12.0    # minimum total rise for valid rep
RETURN_PCT         = 0.30    # return within 30% of rise = back at rest
FALSE_START_RISE   = 6.0     # if rising stalls below this, cancel

# ── Voice ────────────────────────────────────────────────────────
VOICE_ENABLED      = True
VOICE_RATE         = 170
VOICE_VOLUME       = 0.9

JOINT_IDX = [0, 11, 12, 13, 14, 15, 16, 23, 24]


# ══════════════════════════════════════════════════════════════════
# VOICE FEEDBACK (threaded, non-blocking)
# ══════════════════════════════════════════════════════════════════
class VoiceFeedback:
    def __init__(self, enabled=True, rate=170, volume=0.9):
        self._q = queue.Queue()
        self._engine = None
        if enabled:
            try:
                import pyttsx3
                self._engine = pyttsx3.init()
                self._engine.setProperty('rate', rate)
                self._engine.setProperty('volume', volume)
                voices = self._engine.getProperty('voices')
                for v in voices:
                    if 'english' in v.name.lower() or 'david' in v.name.lower():
                        self._engine.setProperty('voice', v.id)
                        break
                print("Voice engine ready")
            except Exception as e:
                print(f"Voice unavailable ({e}) — console only")
                self._engine = None
        self._thread = threading.Thread(target=self._worker, daemon=True)
        self._thread.start()

    def say(self, text, priority=False):
        if priority:
            while not self._q.empty():
                try:
                    self._q.get_nowait()
                except queue.Empty:
                    break
        self._q.put(text)

    def _worker(self):
        while True:
            text = self._q.get()
            print(f"  [voice] {text}")
            if self._engine:
                try:
                    self._engine.say(text)
                    self._engine.runAndWait()
                except Exception:
                    pass


# ══════════════════════════════════════════════════════════════════
# SMOOTH STATE MACHINE — velocity + relative motion
# ══════════════════════════════════════════════════════════════════
class Phase(Enum):
    REST     = "REST"
    RISING   = "RISING"
    FALLING  = "FALLING"
    COOLDOWN = "COOLDOWN"


class SmoothRepDetector:
    """
    Detects reps by reading the SHAPE of movement:
      velocity positive → rising
      velocity crosses zero → peaked
      velocity negative → falling
      angle returns near rest → complete

    No fixed angle thresholds. Adapts to each person's rest position.
    Pre-roll buffer captures the start of motion retroactively.
    """

    def __init__(self):
        self.phase          = Phase.REST
        self.pre_buffer     = collections.deque(maxlen=PRE_ROLL)
        self.rec_buffer     = []

        # Smoothed signals
        self.s_angle        = 0.0       # smoothed angle
        self.s_vel          = 0.0       # smoothed velocity (deg/frame)
        self.prev_angle     = 0.0

        # Adaptive rest baseline (learns YOUR rest position)
        self.rest_angle     = None

        # Rep tracking
        self.peak_angle     = 0.0
        self.rise_amount    = 0.0       # current rise from rest
        self.return_pct     = 1.0       # 0=at rest, 1=at peak
        self.cooldown_count = 0
        self.frame_count    = 0

    def reset(self):
        self.phase          = Phase.REST
        self.pre_buffer.clear()
        self.rec_buffer     = []
        self.s_angle        = 0.0
        self.s_vel          = 0.0
        self.prev_angle     = 0.0
        self.rest_angle     = None
        self.peak_angle     = 0.0
        self.rise_amount    = 0.0
        self.return_pct     = 1.0
        self.cooldown_count = 0
        self.frame_count    = 0

    def update(self, lm, raw_angle):
        """
        Feed one frame.
        Returns:
          np.ndarray (N,33,3)  — complete rep frames
          "timeout"            — recording timed out
          "false_start"        — motion stalled, not a real rep
          None                 — no event
        """
        self.frame_count += 1

        # ── First frame: initialize ───────────────────────────────
        if self.frame_count == 1:
            self.s_angle    = raw_angle
            self.prev_angle = raw_angle
            self.rest_angle = raw_angle
            self.pre_buffer.append(lm.copy())
            return None

        # ── Smooth angle ──────────────────────────────────────────
        self.prev_angle = self.s_angle
        self.s_angle = ANGLE_EMA * raw_angle + (1 - ANGLE_EMA) * self.s_angle

        # ── Smooth velocity (deg/frame) ───────────────────────────
        raw_vel  = self.s_angle - self.prev_angle
        self.s_vel = VEL_EMA * raw_vel + (1 - VEL_EMA) * self.s_vel

        # ── Rise from rest ────────────────────────────────────────
        if self.rest_angle is not None:
            self.rise_amount = self.s_angle - self.rest_angle
        else:
            self.rise_amount = 0.0

        result = None

        # ══════════════════════════════════════════════════════════
        # REST — monitoring, adapting baseline
        # ══════════════════════════════════════════════════════════
        if self.phase == Phase.REST:
            self.pre_buffer.append(lm.copy())

            # Slowly learn rest position (adapts to person)
            self.rest_angle = ((1 - REST_EMA) * self.rest_angle
                               + REST_EMA * self.s_angle)

            # Transition → RISING: velocity sustained upward + risen from rest
            if self.s_vel > VEL_RISING and self.rise_amount > MIN_RISE_FROM_REST:
                self.phase      = Phase.RISING
                self.rec_buffer = list(self.pre_buffer)   # pre-roll!
                self.rec_buffer.append(lm.copy())
                self.peak_angle = self.s_angle
                print(f"  >> RISING  vel={self.s_vel:+.2f}  "
                      f"rise={self.rise_amount:.1f} from rest={self.rest_angle:.1f}")

        # ══════════════════════════════════════════════════════════
        # RISING — arm going up, waiting for peak
        # ══════════════════════════════════════════════════════════
        elif self.phase == Phase.RISING:
            self.rec_buffer.append(lm.copy())
            self.peak_angle = max(self.peak_angle, self.s_angle)

            total_rise = self.peak_angle - self.rest_angle

            # Transition → FALLING: velocity turned negative + meaningful peak
            if self.s_vel < VEL_PEAKED and total_rise > MIN_PEAK_RISE:
                self.phase = Phase.FALLING
                print(f"  >> PEAKED  peak={self.peak_angle:.1f}  "
                      f"total_rise={total_rise:.1f}")

            # False start: velocity stalled and didn't rise enough
            elif (abs(self.s_vel) < VEL_STILL * 0.5
                  and total_rise < FALSE_START_RISE
                  and len(self.rec_buffer) > 20):
                self.phase      = Phase.REST
                self.rec_buffer = []
                self.peak_angle = 0.0
                print(f"  >> false start (rise={total_rise:.1f})")
                return "false_start"

            # Timeout
            if len(self.rec_buffer) > MAX_REC_FRAMES:
                self.phase          = Phase.COOLDOWN
                self.cooldown_count = COOLDOWN_FRAMES
                self.rec_buffer     = []
                self.peak_angle     = 0.0
                return "timeout"

        # ══════════════════════════════════════════════════════════
        # FALLING — arm coming down, waiting for return to rest
        # ══════════════════════════════════════════════════════════
        elif self.phase == Phase.FALLING:
            self.rec_buffer.append(lm.copy())

            # How far back toward rest? (0.0 = at rest, 1.0 = at peak)
            total_rise = max(self.peak_angle - self.rest_angle, 1.0)
            current_rise = max(self.s_angle - self.rest_angle, 0.0)
            self.return_pct = current_rise / total_rise

            # Rep COMPLETE: returned close to rest + velocity near zero
            if self.return_pct < RETURN_PCT and abs(self.s_vel) < VEL_STILL:
                result = np.stack(self.rec_buffer)
                self.phase          = Phase.COOLDOWN
                self.cooldown_count = COOLDOWN_FRAMES
                print(f"  >> COMPLETE  frames={len(result)}  "
                      f"return={self.return_pct:.0%}")
                self.rec_buffer = []
                self.peak_angle = 0.0

            # Timeout
            elif len(self.rec_buffer) > MAX_REC_FRAMES:
                self.phase          = Phase.COOLDOWN
                self.cooldown_count = COOLDOWN_FRAMES
                self.rec_buffer     = []
                self.peak_angle     = 0.0
                return "timeout"

        # ══════════════════════════════════════════════════════════
        # COOLDOWN — brief pause, prevents double-detection
        # ══════════════════════════════════════════════════════════
        elif self.phase == Phase.COOLDOWN:
            self.cooldown_count -= 1
            if self.cooldown_count <= 0:
                self.phase = Phase.REST
                self.pre_buffer.clear()
                # Re-anchor rest to current angle
                self.rest_angle = self.s_angle

        return result


# ══════════════════════════════════════════════════════════════════
# FEATURE PIPELINE (identical to training)
# ══════════════════════════════════════════════════════════════════
def angle_batch(a, b, c):
    ba = a - b; bc = c - b
    dot = np.sum(ba * bc, axis=-1)
    n   = np.linalg.norm(ba, axis=-1) * np.linalg.norm(bc, axis=-1) + 1e-6
    return np.degrees(np.arccos(np.clip(dot / n, -1.0, 1.0)))[:, None]

def ema_smooth(seq, alpha):
    out = [seq[0]]
    for i in range(1, len(seq)):
        out.append(alpha * seq[i] + (1.0 - alpha) * out[-1])
    return np.array(out, dtype=np.float32)

def resample(seq, target):
    T = len(seq)
    if T == target: return seq.astype(np.float32)
    idx = np.linspace(0, T - 1, target)
    out = np.zeros((target, seq.shape[1]), dtype=np.float32)
    for f in range(seq.shape[1]):
        out[:, f] = np.interp(idx, np.arange(T), seq[:, f])
    return out

def process_rep(frames, target_frames):
    T    = len(frames)
    norm = ema_smooth(frames, SMOOTH_ALPHA)

    mid_hip     = (norm[:, 23] + norm[:, 24]) / 2.0
    mid_sho     = (norm[:, 11] + norm[:, 12]) / 2.0
    torso_scale = np.linalg.norm(mid_sho - mid_hip, axis=-1, keepdims=True) + 1e-6

    def norm_y(idx):
        return -(norm[:, idx, 1] - mid_hip[:, 1]) / torso_scale[:, 0]

    wrist_l_y = norm_y(15); wrist_r_y = norm_y(16)
    sho_l_y   = norm_y(11); sho_r_y   = norm_y(12)

    elbow_l = angle_batch(norm[:,11], norm[:,13], norm[:,15])
    elbow_r = angle_batch(norm[:,12], norm[:,14], norm[:,16])

    wl = wrist_l_y[:, None]; wr = wrist_r_y[:, None]
    vel_l = np.concatenate([np.zeros((1,1),np.float32), np.diff(wl,axis=0)],axis=0)
    vel_r = np.concatenate([np.zeros((1,1),np.float32), np.diff(wr,axis=0)],axis=0)
    acc_l = np.concatenate([np.zeros((1,1),np.float32), np.diff(vel_l,axis=0)],axis=0)
    acc_r = np.concatenate([np.zeros((1,1),np.float32), np.diff(vel_r,axis=0)],axis=0)

    peak_w_l  = float(np.max(wrist_l_y)); peak_w_r = float(np.max(wrist_r_y))
    rom_w_l   = peak_w_l - float(np.min(wrist_l_y))
    rom_w_r   = peak_w_r - float(np.min(wrist_r_y))
    peak_f_l  = int(np.argmax(wrist_l_y)); peak_f_r = int(np.argmax(wrist_r_y))
    peak_asym = float(abs(peak_w_l - peak_w_r))

    min_el_l    = float(np.min(elbow_l)); max_el_l = float(np.max(elbow_l))
    min_el_r    = float(np.min(elbow_r)); max_el_r = float(np.max(elbow_r))
    rom_el_l    = max_el_l - min_el_l; rom_el_r = max_el_r - min_el_r
    max_el_asym = float(np.max(np.abs(elbow_l - elbow_r)))

    sho_tilt      = np.abs(sho_l_y - sho_r_y)
    sho_tilt_max  = float(np.max(sho_tilt))
    sho_tilt_mean = float(np.mean(sho_tilt))

    wrist_l_x = (norm[:, 15, 0] - norm[:, 11, 0]) / torso_scale[:, 0]
    wrist_r_x = (norm[:, 16, 0] - norm[:, 12, 0]) / torso_scale[:, 0]
    fwd_l = float(np.max(np.abs(wrist_l_x)))
    fwd_r = float(np.max(np.abs(wrist_r_x)))

    peak_vel_l = float(np.max(np.abs(vel_l)))
    peak_vel_r = float(np.max(np.abs(vel_r)))
    mean_acc_l = float(np.mean(np.abs(acc_l)))
    mean_acc_r = float(np.mean(np.abs(acc_r)))

    timing_l   = float(peak_f_l) / max(T-1,1)
    timing_r   = float(peak_f_r) / max(T-1,1)
    wrist_sync = float(abs(timing_l - timing_r))
    elbow_at_peak_l = float(elbow_l[peak_f_l, 0])
    elbow_at_peak_r = float(elbow_r[peak_f_r, 0])

    hip_mid_x = (norm[:, 23, 0] + norm[:, 24, 0]) / 2.0
    hip_sway  = float(np.max(hip_mid_x) - np.min(hip_mid_x))
    nose_sway = float(np.max(norm[:,0,0]) - np.min(norm[:,0,0]))

    def path_linearity(traj):
        if len(traj) < 2: return 1.0
        steps  = np.sqrt(np.sum(np.diff(traj, axis=0)**2, axis=-1))
        total  = float(np.sum(steps)) + 1e-6
        direct = float(np.linalg.norm(traj[-1] - traj[0])) + 1e-6
        return float(np.clip(direct / total, 0, 1))

    linearity = path_linearity(norm[:, 15, :])
    over_l    = float(np.mean(wrist_l_y > sho_l_y))
    over_r    = float(np.mean(wrist_r_y > sho_r_y))

    depth_feat = np.array([
        peak_w_l, peak_w_r, rom_w_l, rom_w_r, peak_asym,
        min_el_l, min_el_r, rom_el_l, rom_el_r, max_el_asym,
        sho_tilt_max, sho_tilt_mean, fwd_l, fwd_r,
        peak_vel_l, peak_vel_r, mean_acc_l, mean_acc_r,
        timing_l, timing_r, wrist_sync,
        elbow_at_peak_l, elbow_at_peak_r,
        hip_sway, nose_sway, linearity, over_l, over_r,
    ], dtype=np.float32)

    pos      = norm[:, JOINT_IDX, :].reshape(T, -1)
    vel      = np.concatenate([np.zeros_like(pos[:1]), np.diff(pos,axis=0)],axis=0)
    acc      = np.concatenate([np.zeros_like(vel[:1]), np.diff(vel,axis=0)],axis=0)
    seq_feat = np.concatenate(
        [pos,vel,acc,elbow_l,elbow_r,wl,vel_l,acc_l,wr,vel_r,acc_r],axis=1
    ).astype(np.float32)

    return resample(seq_feat, target_frames), depth_feat


def right_shoulder_angle(lm):
    down = np.array([0.0, 1.0, 0.0], np.float32)
    v = lm[14] - lm[12]
    n = np.linalg.norm(v)
    if n < 1e-6: return 0.0
    return float(np.degrees(np.arccos(np.clip(np.dot(v / n, down), -1, 1))))


