def compute_similarity_matrix(latent_vectors):
    """Cosine similarity matrix"""
    norms = np.linalg.norm(latent_vectors, axis=1, keepdims=True) + 1e-8
    normalized = latent_vectors / norms
    return normalized @ normalized.T

