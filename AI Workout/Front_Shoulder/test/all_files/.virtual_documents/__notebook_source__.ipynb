detected_periods = {}

for cls_idx, cls in enumerate(class_names):
    cls_data = data[data['class_name'] == cls].sort_values(['rep_id'])
    rep_ids = sorted(cls_data['rep_id'].unique())[:8]

    # Build continuous stream
