    h = get_lm(r, RH); ls = get_lm(r, LS)

    arm_elev[i] = angle_3pt(h, s, w)
    elbow_ang[i] = angle_3pt(s, e, w)

    vert = np.array([0, -1, 0])
    tv = s - h
    c = np.dot(vert, tv) / (np.linalg.norm(tv) + 1e-8)
    torso_lean[i] = np.degrees(np.arccos(np.clip(c, -1, 1)))

    shoulder_diff[i] = ls[1] - s[1]

