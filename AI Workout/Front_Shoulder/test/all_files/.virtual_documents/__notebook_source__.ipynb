# =============================================================================
# MOBILE INFERENCE REFERENCE CODE
# =============================================================================
# This file documents the exact inference pipeline for mobile integration.
# Adapt to your platform (Android/Kotlin, iOS/Swift, Flutter/Dart).
#
# Required files:
