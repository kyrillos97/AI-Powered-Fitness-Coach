            elbow[np.argmax(arm)],                           # elbow at peak
            np.max(torso),                                   # max torso lean
            torso[np.argmax(arm)],                           # torso at peak
            np.std(np.diff(arm)),                            # jerkiness
            np.linalg.norm(latents_rep[np.argmax(arm)] -
                          latents_rep[0]),                    # latent distance to peak
        ]

