# ══════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════
def main(model_path, labels_path, camera_id):

    label_names = ["front_shoulder_bent_elbow", "front_shoulder_low",
                   "front_shoulder_over_range", "front_shoulder_perfect"]
    try:
        with open(labels_path) as f:
            lines = [l.strip() for l in f if l.strip()]
            if lines:
                label_names = [l.split(",",1)[1].strip() if "," in l
                               else l for l in lines]
    except FileNotFoundError:
        pass
    print(f"Labels: {label_names}")

    # ── Classifier ─────────────────────────────────────────────────
    try:
        interp = Interpreter(model_path=model_path, num_threads=4)
    except TypeError:
        interp = Interpreter(model_path=model_path)
    interp.allocate_tensors()
    inp = interp.get_input_details()
    out = interp.get_output_details()

    TARGET_FRAMES = 48
    for d in inp:
        if len(d["shape"]) == 3:
            TARGET_FRAMES = int(d["shape"][1]); break

    LATENT_DIM = 8
    for d in inp:
        if len(d["shape"]) == 2 and d["shape"][-1] <= 16:
            LATENT_DIM = int(d["shape"][-1]); break
    print(f"TARGET_FRAMES={TARGET_FRAMES}  LATENT_DIM={LATENT_DIM}")

    # ── VAE (for z fusion only — NO rejection) ────────────────────
    vae_interp = None; vae_inp = None; vae_out_det = None
    vae_sc_mean = None; vae_sc_scale = None

    base_dir = os.path.dirname(model_path)

    _vae_path = os.path.join(base_dir, "front_shoulder_vae_encoder.tflite")
    if os.path.exists(_vae_path):
        try:
            vae_interp = Interpreter(model_path=_vae_path, num_threads=2)
            vae_interp.allocate_tensors()
            vae_inp     = vae_interp.get_input_details()
            vae_out_det = vae_interp.get_output_details()
            print(f"VAE loaded (z fusion only, no rejection)")
        except Exception as e:
            print(f"VAE load failed: {e}"); vae_interp = None

    _stats_path = os.path.join(base_dir,
                               "best_front_shoulder_model_feature_stats.npz")
    if os.path.exists(_stats_path):
        try:
            _st = np.load(_stats_path, allow_pickle=True)
            if "vae_scaler_mean" in _st:
                vae_sc_mean  = _st["vae_scaler_mean"].astype(np.float32)
                vae_sc_scale = _st["vae_scaler_scale"].astype(np.float32)
            if "target_frames" in _st:
                tf_saved = int(_st["target_frames"][0])
                if tf_saved != TARGET_FRAMES:
                    print(f"  Override TARGET_FRAMES -> {tf_saved}")
                    TARGET_FRAMES = tf_saved
        except Exception as e:
            print(f"Stats load failed: {e}")

    def run_vae_z(depth_feat):
        """Get VAE latent z for classifier fusion. Never rejects."""
        if vae_interp is None or vae_sc_mean is None:
            return np.zeros(LATENT_DIM, np.float32)
        n = min(len(depth_feat), len(vae_sc_mean))
        x = ((depth_feat[:n] - vae_sc_mean[:n]) /
             (vae_sc_scale[:n] + 1e-6)).reshape(1,-1).astype(np.float32)
        vae_interp.set_tensor(vae_inp[0]["index"], x)
        vae_interp.invoke()
        # Get mu (mean) — deterministic, stable
        mu_t = None
        for d in vae_out_det:
            nm = d["name"].lower()
            if "mu" in nm or ("mean" in nm and "log" not in nm):
                mu_t = vae_interp.get_tensor(d["index"])[0]
                break
        if mu_t is None:
            mu_t = vae_interp.get_tensor(vae_out_det[0]["index"])[0]
        return mu_t.astype(np.float32)

    def run_model(seq_feat, depth_feat, z_vec):
        for d in inp:
            nm = d["name"].lower()
            if len(d["shape"]) == 3:
                interp.set_tensor(d["index"],
                    seq_feat[np.newaxis].astype(np.float32))
            elif "latent" in nm or "z" in nm:
                interp.set_tensor(d["index"],
                    z_vec[np.newaxis].astype(np.float32))
            else:
                n = int(d["shape"][-1])
                interp.set_tensor(d["index"],
                    depth_feat[:n][np.newaxis].astype(np.float32))
        interp.invoke()
        return interp.get_tensor(out[0]["index"])[0].astype(np.float32)

    # ── MediaPipe ──────────────────────────────────────────────────
    mp_pose    = mp.solutions.pose
    mp_drawing = mp.solutions.drawing_utils
    pose = mp_pose.Pose(min_detection_confidence=0.5,
                        min_tracking_confidence=0.5)

    cap = cv2.VideoCapture(camera_id)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    # ── Init ───────────────────────────────────────────────────────
    voice = VoiceFeedback(enabled=VOICE_ENABLED,
                          rate=VOICE_RATE, volume=VOICE_VOLUME)
    sm    = SmoothRepDetector()

    rep_count     = 0
    last_label    = "---"
    last_conf     = 0.0
    r_sho_angle   = 0.0
    flash_timer   = 0
    flash_color   = (0,0,0)
    history       = collections.deque(maxlen=10)
    set_results   = []

    voice.say("Front shoulder raise. Raise arms when ready.", priority=True)

    print("\n" + "="*55)
    print("  SMOOTH VELOCITY-BASED REP DETECTION")
    print("  No hard thresholds. No OOD rejection.")
    print("  Q/ESC=quit  R=reset  S=set summary")
    print("="*55 + "\n")

    while True:
        ret, frame = cap.read()
        if not ret:
            break
        frame = cv2.flip(frame, 1)
        rgb   = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        res   = pose.process(rgb)
        H, W  = frame.shape[:2]

        if res.pose_landmarks:
            lms = res.pose_landmarks.landmark
            lm  = np.array([[l.x, l.y, l.z] for l in lms], dtype=np.float32)
            r_sho_angle = right_shoulder_angle(lm)

            # ── State Machine ──────────────────────────────────────
            result = sm.update(lm, r_sho_angle)

            # Check result type safely (avoids numpy ambiguity)
            if isinstance(result, str):
                if result == "timeout":
                    voice.say("Timeout. Try again.")
                # "false_start" is silent — just resets

            elif result is not None:
                # ── FULL REP CAPTURED → classify ───────────────────
                n_frames = len(result)
                print(f"  Classifying {n_frames} frames...")

                seq, dep = process_rep(result, TARGET_FRAMES)

                # Get VAE z (for fusion, never rejects)
                z_vec = run_vae_z(dep)

                # Classify
                probs = run_model(seq, dep, z_vec)
                i_max = int(np.argmax(probs))
                conf  = float(probs[i_max])
                last_label = (label_names[i_max]
                              if i_max < len(label_names) else str(i_max))
                last_conf = conf
                rep_count += 1

                short = SHORT_LABELS.get(last_label.lower(), last_label)
                vtxt  = VOICE_LABELS.get(last_label.lower(), short)
                voice.say(f"Rep {rep_count}. {vtxt}", priority=True)

                print(f"  -> Rep #{rep_count}: {last_label} ({conf*100:.1f}%)")

                flash_color = COLORS.get(last_label.lower(), (100,100,100))
                flash_timer = 25
                history.appendleft((last_label, conf))
                set_results.append((last_label, conf))

            # ── Skeleton ───────────────────────────────────────────
            mp_drawing.draw_landmarks(
                frame, res.pose_landmarks, mp_pose.POSE_CONNECTIONS,
                mp_drawing.DrawingSpec(color=(180,180,180),
                                       thickness=1, circle_radius=2),
                mp_drawing.DrawingSpec(color=(80,80,80), thickness=1))

            # Right arm colored by phase
            pcol = PHASE_COLORS.get(sm.phase, (180,180,180))
            for si, ei in [(12,14), (14,16)]:
                cv2.line(frame,
                         (int(lm[si,0]*W), int(lm[si,1]*H)),
                         (int(lm[ei,0]*W), int(lm[ei,1]*H)),
                         pcol, 4)
            for si, ei in [(11,13), (13,15)]:
                cv2.line(frame,
                         (int(lm[si,0]*W), int(lm[si,1]*H)),
                         (int(lm[ei,0]*W), int(lm[ei,1]*H)),
                         (180,180,180), 2)

            # Angle on shoulder
            rs = (int(lm[12,0]*W), int(lm[12,1]*H))
            cv2.putText(frame, f"{r_sho_angle:.0f}",
                        (rs[0]+10, rs[1]-12),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, pcol, 2)

        # ── FLASH ──────────────────────────────────────────────────
        if flash_timer > 0:
            overlay = frame.copy()
            alpha   = min(0.22, flash_timer / 50.0)
            cv2.rectangle(overlay, (0,0), (W,H), flash_color, -1)
            cv2.addWeighted(overlay, alpha, frame, 1-alpha, 0, frame)
            flash_timer -= 1

        # ── VELOCITY BAR (left side) ───────────────────────────────
        # Shows motion direction: green=up, red=down, gray=still
        bar_x, bar_y, bar_w, bar_h = 15, 80, 18, 140
        bar_mid = bar_y + bar_h // 2

        # Background
        cv2.rectangle(frame, (bar_x, bar_y), (bar_x+bar_w, bar_y+bar_h),
                      (40,40,40), -1)
        cv2.line(frame, (bar_x, bar_mid), (bar_x+bar_w, bar_mid),
                 (100,100,100), 1)

        # Velocity fill (clamped)
        vel_px = int(np.clip(sm.s_vel * 30, -bar_h//2, bar_h//2))
        if vel_px > 2:
            cv2.rectangle(frame, (bar_x+2, bar_mid-vel_px),
                          (bar_x+bar_w-2, bar_mid), (0,220,80), -1)
        elif vel_px < -2:
            cv2.rectangle(frame, (bar_x+2, bar_mid),
                          (bar_x+bar_w-2, bar_mid-vel_px), (0,100,255), -1)

        cv2.putText(frame, "VEL", (bar_x, bar_y-5),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.3, (150,150,150), 1)

        # ── RISE METER (next to velocity bar) ──────────────────────
        rise_x = bar_x + bar_w + 10
        rise_max_display = 80.0  # degrees for full bar
        rise_fill = np.clip(sm.rise_amount / rise_max_display, 0, 1)

        cv2.rectangle(frame, (rise_x, bar_y), (rise_x+bar_w, bar_y+bar_h),
                      (40,40,40), -1)

        fill_h = int(rise_fill * bar_h)
        if fill_h > 0:
            rise_col = PHASE_COLORS.get(sm.phase, (180,180,180))
            cv2.rectangle(frame, (rise_x+2, bar_y+bar_h-fill_h),
                          (rise_x+bar_w-2, bar_y+bar_h), rise_col, -1)

        cv2.putText(frame, "RISE", (rise_x-2, bar_y-5),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.3, (150,150,150), 1)

        # ── RETURN METER (during falling) ──────────────────────────
        if sm.phase == Phase.FALLING:
            ret_x = rise_x + bar_w + 10
            ret_fill = 1.0 - np.clip(sm.return_pct, 0, 1)
            cv2.rectangle(frame, (ret_x, bar_y), (ret_x+bar_w, bar_y+bar_h),
                          (40,40,40), -1)
            rh = int(ret_fill * bar_h)
            if rh > 0:
                cv2.rectangle(frame, (ret_x+2, bar_y+bar_h-rh),
                              (ret_x+bar_w-2, bar_y+bar_h), (255,140,0), -1)
            cv2.putText(frame, "RET", (ret_x-2, bar_y-5),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.3, (150,150,150), 1)

        # ── PHASE INDICATOR ────────────────────────────────────────
        pcol = PHASE_COLORS.get(sm.phase, (180,180,180))
        phase_txt = sm.phase.value
        if sm.phase == Phase.RISING:
            cv2.circle(frame, (W//2, 25), 8, (0,0,255), -1)
            phase_txt += f"  {len(sm.rec_buffer)}f"
        elif sm.phase == Phase.FALLING:
            cv2.circle(frame, (W//2, 25), 8, (255,140,0), -1)
            phase_txt += f"  {sm.return_pct:.0%} left"

        cv2.putText(frame, phase_txt, (W//2 + 15, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, pcol, 2)

        # ── REPS + RESULT ──────────────────────────────────────────
        cv2.putText(frame, f"REPS: {rep_count}",
                    (20, H-55),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.2, (255,255,255), 3)

        col  = COLORS.get(last_label.lower(), (180,180,180))
        disp = SHORT_LABELS.get(last_label.lower(), last_label.upper())
        cv2.putText(frame, f"{disp}  {last_conf*100:.0f}%",
                    (20, H-15),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.85, col, 2)

        # History
        for i, (hl, hc) in enumerate(history):
            d = SHORT_LABELS.get(hl.lower(), hl)
            c = COLORS.get(hl.lower(), (180,180,180))
            cv2.putText(frame, f"{i+1}. {d} {hc*100:.0f}%",
                        (W-220, 55+i*22),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.38, c, 1)

        # Debug line
        rest_s = f"rest={sm.rest_angle:.1f}" if sm.rest_angle else "calibrating"
        cv2.putText(frame,
                    f"ang={sm.s_angle:.1f}  vel={sm.s_vel:+.2f}  "
                                        f"rise={sm.rise_amount:.1f}  {rest_s}  {sm.phase.value}",
                    (20, H-80),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.32, (110,110,110), 1)

        # ── KEY HANDLING ───────────────────────────────────────────
        cv2.imshow("Front Shoulder Classifier", frame)
        key = cv2.waitKey(1) & 0xFF

        if key in (ord("q"), 27):
            break

        if key in (ord("r"), ord("R")):
            sm.reset()
            rep_count = 0; history.clear(); set_results.clear()
            last_label = "---"; last_conf = 0.0
            flash_timer = 0; r_sho_angle = 0.0
            voice.say("Reset. Ready for new set.", priority=True)
            print("Reset.")

        if key in (ord("s"), ord("S")):
            if set_results:
                print("\n--- SET SUMMARY ---")
                counts = {}
                for lb, cf in set_results:
                    sn = SHORT_LABELS.get(lb.lower(), lb)
                    counts[sn] = counts.get(sn, 0) + 1
                for lb, ct in counts.items():
                    print(f"  {lb}: {ct}")
                total = len(set_results)
                perfect = sum(1 for lb, _ in set_results
                              if "perfect" in lb.lower())
                pct = perfect / total * 100 if total else 0
                print(f"  Total: {total} reps  ({pct:.0f}% perfect)")
                print("-------------------\n")
                voice.say(f"Set complete. {total} reps. "
                          f"{pct:.0f} percent perfect.", priority=True)

            sm.reset()
            rep_count = 0; history.clear(); set_results.clear()
            last_label = "---"; last_conf = 0.0
            flash_timer = 0
            voice.say("New set. Go when ready.", priority=True)
            print("New set started.")

    # ── Cleanup ────────────────────────────────────────────────────
    if set_results:
        print("\n--- FINAL SUMMARY ---")
        counts = {}
        for lb, cf in set_results:
            sn = SHORT_LABELS.get(lb.lower(), lb)
            counts[sn] = counts.get(sn, 0) + 1
        for lb, ct in counts.items():
            print(f"  {lb}: {ct}")
        total = len(set_results)
        perfect = sum(1 for lb, _ in set_results if "perfect" in lb.lower())
        pct = perfect / total * 100 if total else 0
        print(f"  Total: {total} reps  ({pct:.0f}% perfect)")
        print("---------------------")

    cap.release()
    cv2.destroyAllWindows()
    pose.close()
    print("Done.")


