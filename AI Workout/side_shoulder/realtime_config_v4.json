  ],
  "ood_policy": {
    "rule": "OOD if (recon > rec_thr) OR (mahalanobis > mh_thr) OR (motion_range < motion_thr)",
    "rationale": "Triple-gate. (1) Recon catches structurally-impossible inputs the VAE cannot reproduce. (2) Mahalanobis catches inputs whose latent code falls outside the training cloud (handles 'looks plausible but isn't from this distribution'). (3) Motion-range catches idle/squat/static poses where the shoulders barely move \u2014 the VAE happily reconstructs these because they resemble the resting frames at the start/end of training reps, but they aren't actual workout reps.",
    "motion_range_definition": "min over (R_sho_abd, L_sho_abd) channels of (max - min over time) on standardized input. A real two-arm raise has motion_range >> 0 in both shoulder channels; idle/single-arm/squat does not.",
    "thresholds_calibration": {
      "recon": "max(train, val) recon p99 \u00d7 1.5",
      "mahalanobis": "max(train, val) mahalanobis p99 \u00d7 1.3",
      "motion": "max(train p1, val min) \u00d7 0.5  (outlier-robust)"
    }
